{
  "ai": {
    "provider": "openai",
    "model": "glm-4.5-flash",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key_env": "GLM_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "commodities-macro",
    "profile_settings": {
      "commodities-macro": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "us-consumer": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false
    },
    "rss": [
      {
        "name": "ZeroHedge",
        "url": "https://feeds.feedburner.com/zerohedge/feed",
        "enabled": true,
        "category": "macro",
        "profile": ["commodities-macro", "us-consumer"]
      },
      {
        "name": "GoogleNews VLCC/tankers",
        "url": "https://news.google.com/rss/search?q=VLCC%20OR%20%22tanker%20rates%22%20OR%20%22oil%20tanker%22&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "shipping"
      },
      {
        "name": "GoogleNews uranium",
        "url": "https://news.google.com/rss/search?q=uranium%20OR%20Kazatomprom%20OR%20Cameco&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "uranium"
      },
      {
        "name": "GoogleNews tungsten",
        "url": "https://news.google.com/rss/search?q=tungsten%20OR%20%22ammonium%20paratungstate%22%20OR%20%22tungsten%20prices%22&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "tungsten"
      },
      {
        "name": "GoogleNews phosphate/fertilizer",
        "url": "https://news.google.com/rss/search?q=DAP%20OR%20phosphate%20OR%20fertilizer&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "phosphate"
      },
      {
        "name": "GoogleNews El Nino/monsoon",
        "url": "https://news.google.com/rss/search?q=%22El%20Nino%22%20OR%20%22La%20Nina%22%20OR%20monsoon&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "weather"
      },
      {
        "name": "GoogleNews aluminum/coal",
        "url": "https://news.google.com/rss/search?q=alumina%20OR%20%22aluminum%20smelter%22%20OR%20%22thermal%20coal%22%20OR%20%22coal%20price%22&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "metals"
      },
      {
        "name": "GoogleNews Lululemon/athleisure",
        "url": "https://news.google.com/rss/search?q=Lululemon%20OR%20athleisure&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "us-consumer"
      },
      {
        "name": "GoogleNews US consumer data",
        "url": "https://news.google.com/rss/search?q=%22consumer%20spending%22%20OR%20%22retail%20sales%22%20OR%20%22consumer%20confidence%22&hl=en&gl=US&ceid=US:en",
        "enabled": true,
        "category": "us-consumer"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "us-consumer",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "gdelt": {
      "enabled": true,
      "query": "uranium OR tungsten OR phosphate OR alumina OR tanker",
      "max_records": 75,
      "category": "macro",
      "profile": "commodities-macro"
    },
    "google_news": {
      "enabled": true,
      "query": "Lululemon OR athleisure OR \"retail sales\" OR \"consumer spending\" OR \"Federal Reserve\"",
      "language": "en",
      "country": "US",
      "max_results": 100,
      "category": "us-consumer",
      "profile": "us-consumer"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 40,
    "profile_order": [
      "commodities-macro",
      "us-consumer"
    ],
    "category_groups": {
      "shipping": {
        "limit": 6,
        "categories": ["shipping"]
      },
      "fertilizer": {
        "limit": 5,
        "categories": ["phosphate", "weather"]
      },
      "uranium": {
        "limit": 5,
        "categories": ["uranium"]
      },
      "tungsten": {
        "limit": 4,
        "categories": ["tungsten"]
      },
      "metals": {
        "limit": 5,
        "categories": ["metals"]
      },
      "macro-us": {
        "limit": 8,
        "categories": ["macro", "finance", "us-consumer"]
      }
    },
    "default_group": "other",
    "default_group_limit": 5
  },
  "webhook": {
    "enabled": false
  }
}
